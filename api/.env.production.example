# ==============================================================================
# CONTOH KONFIGURASI PRODUCTION UNTUK SHARED HOSTING (CPANEL)
# Salin file ini menjadi .env di dalam folder api/ pada hosting Anda
# ==============================================================================

APP_NAME="Sunny Dealer"
APP_ENV=production
APP_KEY=base64:fCSBwisETih6679GB9XldcSHRoxJtpW2c6vTMOdjQNU=
APP_DEBUG=false
APP_URL=https://namadomainanda.com/api

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ==============================================================================
# DATABASE (SESUAIKAN DENGAN CPANEL MYSQL DATABASE ANDA)
# Catatan: Di cPanel, nama DB dan Username selalu ada prefix username cPanel!
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=usernamecpanel_sunny
DB_USERNAME=usernamecpanel_dbuser
DB_PASSWORD=password_database_rahasia_anda

# ==============================================================================
# SESSION & CACHE (Gunakan 'file' jika shared hosting tidak ada Redis)
# ==============================================================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ==============================================================================
# OPENROUTER AI CONFIGURATION (SUNNY AI ASSISTANT)
# ==============================================================================
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_SITE_URL=https://namadomainanda.com
OPENROUTER_APP_NAME="Sunny AI Dealer"
